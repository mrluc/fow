defmodule <%= @module %>.HomeScreenTest do
  use ExUnit.Case, async: false
  for platform <- <%= inspect(Enum.map(@mobile_platforms, fn platform -> if platform == "android", do: :android, else: :ios end)) %> do
    test "mount selects the #{platform} bundle at the real website URL" do
      platform = unquote(platform)
      socket = Mob.Socket.new(<%= @module %>.HomeScreen, platform: platform)
      assert {:ok, socket} = <%= @module %>.HomeScreen.mount(%{}, %{}, socket)
      assert socket.assigns.url == <%= inspect(@live) %>
      assert <%= inspect(@origin <> "/") %> in socket.assigns.allowed
      assert socket.assigns.bundle["platform"] == Atom.to_string(platform)
      assert File.regular?(socket.assigns.bundle["startup"])
    end
  end
end
