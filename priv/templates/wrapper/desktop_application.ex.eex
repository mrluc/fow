defmodule <%= @module %>.Application do
  use Application
  def start(_, _) do
    Supervisor.start_link([
      <%= @module %>.PublicShell,
      {ElixirKit.PubSub, connect: System.get_env("ELIXIRKIT_PUBSUB") || :ignore, on_exit: &System.stop/0},
      {Task, fn ->
        if System.get_env("ELIXIRKIT_PUBSUB"), do:
          ElixirKit.PubSub.broadcast("desktop", "ready:" <> <%= @module %>.PublicShell.url())
      end}
    ], strategy: :one_for_one, name: <%= @module %>.Supervisor)
  end
end
