defmodule <%= @module %>.App do
  use Mob.App
  def navigation(_platform), do: stack(:main, root: <%= @module %>.HomeScreen)
  def on_start do
    Mob.DNS.configure_pure_beam()
    Mob.Screen.start_root(<%= @module %>.HomeScreen)
    Mob.Dist.ensure_started(node: :"<%= @app %>_android@127.0.0.1")
  end
end
