defmodule <%= @module %>.App do
  use Mob.App
  def navigation(_platform), do: stack(:main, root: <%= @module %>.HomeScreen)
  def on_start do
    Mob.DNS.configure_pure_beam()
    {:ok, _} = Application.ensure_all_started(:bandit)
    # Mob owns the application supervisor; link this small public server to its app process.
    case <%= @module %>.PublicShell.start_link([]) do
      {:ok, _} -> :ok
      {:error, {:already_started, _}} -> :ok
    end
    Mob.Screen.start_root(<%= @module %>.HomeScreen)
  end
end
