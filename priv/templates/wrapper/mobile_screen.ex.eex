defmodule <%= @module %>.HomeScreen do
  use Mob.Screen
  def mount(_, _, socket) do
    platform = Atom.to_string(socket.__mob__.platform)
    bundle = Application.app_dir(:<%= @app %>, "priv/fog_of_war/" <> platform) |> MobWebView.Bundle.load!()
    {:ok, Mob.Socket.assign(socket, bundle: bundle, url: bundle["url"], allowed: [<%= inspect(@origin <> "/") %>])}
  end
  def render(assigns) do
    ~MOB"""
    <Column fill_width={true} fill_height={true}>
      {MobWebView.view(id: :site, url: @url, bundle: @bundle, allow: @allowed, fill_width: true, fill_height: true)}
    </Column>
    """
  end
  def handle_info(_, socket), do: {:noreply, socket}
end
