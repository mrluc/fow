{
  "app": {
    "icon": "priv/static/images/logo.svg",
    "identifier": "dev.fogofwar.counters",
    "name": "Counters",
    "slug": "counters",
    "version": "0.1.0"
  },
  "elixirkit": {
    "height": 760,
    "width": 1060
  },
  "mob": {
    "platforms": [
      "android",
      "ios"
    ]
  },
  "public": {
    "asset_directories": [
      "assets",
      "css",
      "fonts",
      "images"
    ],
    "bundle": ".fow/public",
    "note": "Only list routes whose unauthenticated rendered content may be distributed publicly. No cookies are exported.",
    "paths": [
      "/",
      "/counters/one",
      "/counters/two"
    ],
    "static_root": "priv/static"
  },
  "schema": 2,
  "web": {
    "discovered_routes": [
      "/",
      "/counters/:id"
    ],
    "endpoint": "FogOfWarBasicWeb.Endpoint",
    "origin": "http://127.0.0.1:47180",
    "router": "FogOfWarBasicWeb.Router",
    "start_path": "/"
  },
  "default_env": "dev",
  "envs": {
    "dev": {},
    "prod": {
      "web": {
        "origin": "https://counters.example"
      },
      "app": {
        "identifier": "dev.fogofwar.counters.production"
      }
    },
    "android-dev": {
      "mob": {
        "platforms": [
          "android"
        ]
      }
    }
  }
}
