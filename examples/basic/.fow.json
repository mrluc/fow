{
  "app": {
    "icon": "priv/static/images/logo.svg",
    "identifier": "dev.fogofwar.counters",
    "name": "Counters",
    "slug": "counters",
    "version": "0.1.0"
  },
  "elixirkit": {
    "height": 760,
    "width": 1060
  },
  "mob": {
    "platforms": [
      "android",
      "ios"
    ]
  },
  "schema": 3,
  "web": {
    "discovered_routes": [
      "/",
      "/counters/:id"
    ],
    "endpoint": "FogOfWarBasicWeb.Endpoint",
    "origin": "http://127.0.0.1:47180",
    "router": "FogOfWarBasicWeb.Router"
  },
  "default_env": "dev",
  "envs": {
    "dev": {},
    "prod": {
      "web": {
        "origin": "https://fow-counters.fly.dev"
      },
      "app": {
        "identifier": "dev.fogofwar.counters.production"
      }
    },
    "android-dev": {
      "mob": {
        "platforms": [
          "android"
        ]
      }
    }
  },
  "startup": {
    "path": "/"
  },
  "preload": {
    "paths": [
      "/counters/one",
      "/counters/two"
    ]
  },
  "assets": {
    "static_root": "priv/static",
    "directories": [
      "assets",
      "css",
      "fonts",
      "images"
    ]
  }
}
